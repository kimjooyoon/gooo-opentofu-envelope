package opentofuenvelope
namespace opentofuenvelope

entity ServiceInfrastructureContract id "envelope://opentofu/service/web/contract"
entity ServicePortContract id "envelope://opentofu/service/web/port"
entity OpenTofuSpecBinding id "envelope://opentofu/service/web/spec-binding"
entity OpenTofuJSONSpecReceipt id "envelope://opentofu/service/web/spec-receipt"
entity OpenTofuArtifact id "envelope://opentofu/service/web/main-tf-json"
entity HumanDossier id "envelope://opentofu/service/web/dossier"
entity NormalVerification id "envelope://opentofu/service/web/normal-verification"
entity OpenTofuValidationReceipt id "envelope://opentofu/service/web/validate-receipt"
entity SemanticOracleMatch id "envelope://opentofu/service/web/oracle-match"
entity UnknownCase id "envelope://opentofu/service/web/unknown"
entity RefutedCase id "envelope://opentofu/service/web/refuted"
entity ReplayVerification id "envelope://opentofu/service/web/replay"
entity ReadOnlyObservation id "envelope://opentofu/service/web/read-only"

// @service name=web type=http port=8080
// @environment name=APP_ENV type=string value=production
// @required_output name=service_url type=string
// @required_output name=service_port type=number
// @required_output name=service_type type=string
// @relation subject=service predicate=declares object=service_port
// @relation subject=service predicate=declares object=service_type
// @relation subject=service predicate=requires object=service_url
// @relation subject=environment predicate=configures object=service

activity DeclareGoooInfrastructureIntent(ServiceInfrastructureContract) -> ServicePortContract
activity BindGoooIntentToOpenTofu(ServicePortContract) -> OpenTofuSpecBinding
activity ConsumePinnedOpenTofuJSONSpec(OpenTofuSpecBinding) -> OpenTofuJSONSpecReceipt
activity GenerateOpenTofuCompatibleArtifact(OpenTofuJSONSpecReceipt) -> OpenTofuArtifact
activity GenerateHumanDossier(OpenTofuArtifact) -> HumanDossier
activity VerifyGeneratedOutputs(HumanDossier) -> NormalVerification
activity GenerateOpenTofuValidationReceipt(NormalVerification) -> OpenTofuValidationReceipt
activity MatchGoooIntentToIndependentOracle(OpenTofuValidationReceipt) -> SemanticOracleMatch
activity PreserveUnknownCase(SemanticOracleMatch) -> UnknownCase
activity RefuteContradictionCase(SemanticOracleMatch) -> RefutedCase
activity VerifyDeterministicReplay(NormalVerification) -> ReplayVerification
activity PreserveReadOnlyBoundary(UnknownCase, RefutedCase, ReplayVerification, SemanticOracleMatch) -> ReadOnlyObservation
